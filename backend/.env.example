# ==========================================
# Telegram MTProto Client (Scraper)
# ==========================================
# Get these credentials from https://my.telegram.org
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash
TG_PHONE_NUMBER=+251900000000
TG_TARGET_CHANNELS=freelance_ethiopia,habeshajobs,remote_dev_jobs

# ==========================================
# Telegram Bot (Instant Push Alerts)
# ==========================================
# Create a bot via @BotFather and get your user ID via @userinfobot
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TG_USER_CHAT_ID=987654321

# ==========================================
# AI / LLM (Gemini API)
# ==========================================
# Obtain key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Database Configuration
# ==========================================
# For local prototyping SQLite: sqlite:///./jobradar.db
# For PostgreSQL: postgresql://postgres:password@localhost:5432/jobradar
DATABASE_URL=sqlite:///./jobradar.db

# ==========================================
# Matching & Alert Thresholds (0-100)
# ==========================================
INSTANT_ALERT_THRESHOLD=75
SAVE_TO_DB_THRESHOLD=50

# ==========================================
# LinkedIn Scraper Settings
# ==========================================
LINKEDIN_SCRAPE_INTERVAL_HOURS=6
LINKEDIN_SEARCH_TERMS=Software Engineer,Full Stack Developer,Backend Developer
LINKEDIN_LOCATION=Remote
